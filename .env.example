# Copy this file to .env and fill in the values. Never commit .env.
# Used by scripts/ and tests/. The Streamlit app reads .streamlit/secrets.toml instead.
# Only the ANON (public) key goes here. Never put the service-role key in any file.

# Dev Supabase project (daily work)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Test Supabase project (integration tests only; reset before each run)
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
