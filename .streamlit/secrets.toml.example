# Copy this file to .streamlit/secrets.toml and fill in the values. Never commit secrets.toml.
# On Streamlit Community Cloud, paste the same lines into the app's Secrets settings instead.
# Only the ANON (public) key goes here. Never put the service-role key in any file.
# Same names as .env, as the training playbook expects (fast-track-playbook.md, Prompt D and Section 8).

SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
